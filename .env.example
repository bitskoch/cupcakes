# =========================================================
# DESARROLLO LOCAL (PostgreSQL instalado nativamente en Windows)
# =========================================================
# Reemplaza "postgres" (después de los ":") por el password que
# configuraste al instalar PostgreSQL, si usaste uno distinto.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proforma"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/proforma"

# =========================================================
# PRODUCCIÓN (Supabase) — descomentar cuando migres
# =========================================================
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Storage (imágenes) — se activa más adelante ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth admin ---
ADMIN_EMAIL="admin@tuempresa.com"
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""
